# Configuración de Río Bravo Inventario — PLANTILLA (esta sí va a git, sin claves).
# 1. Copie este archivo con el nombre ".env" (sin .example).
# 2. Reemplace PEGA_AQUI_LA_CLAVE por la clave real de app_riobravo.
# 3. Desarrollo: deje el .env en la carpeta del proyecto.
#    Instalación: deje el .env junto a gestion_inventario_rio_bravo.exe.
# El .env NO se sube a git (.gitignore) y se entrega solo por canal interno.
# Formato: CLAVE=valor, sin espacios alrededor; las líneas con # al inicio son comentarios.

# --- Base de datos (Supabase, pooler) ---
RIOBRAVO_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
RIOBRAVO_DB_PORT=6543
RIOBRAVO_DB_NAME=postgres
# Usuario limitado de la app (nunca "postgres"). Formato del pooler: usuario.ref_del_proyecto
RIOBRAVO_DB_USER=app_riobravo.zjquxoxepevlymvnhfcw
RIOBRAVO_DB_PASSWORD=PEGA_AQUI_LA_CLAVE

# --- Seguridad de la conexión (opcionales; estos son los valores por defecto) ---
RIOBRAVO_DB_SSLMODE=Require
RIOBRAVO_DB_TRUST_SERVER_CERTIFICATE=true
# Segundos de espera al conectar
RIOBRAVO_DB_TIMEOUT=15
