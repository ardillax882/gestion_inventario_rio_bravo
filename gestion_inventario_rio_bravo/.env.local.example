# Valores para Supabase LOCAL (Docker) — solo desarrollo.
# El programa solo lee el archivo ".env". Para trabajar con la base local, copie estas
# líneas en su .env (guarde antes sus valores de producción en un lugar seguro).
# La clave sale de supabase/seed.sql y solo sirve en su PC: no es secreta.
# Iniciar:   npx supabase@2.117.0 start      (desde la carpeta raíz del repositorio)
# Reiniciar la BD desde cero: npx supabase@2.117.0 db reset

RIOBRAVO_DB_HOST=127.0.0.1
RIOBRAVO_DB_PORT=54322
RIOBRAVO_DB_NAME=postgres
RIOBRAVO_DB_USER=app_riobravo
RIOBRAVO_DB_PASSWORD=riobravo_local
RIOBRAVO_DB_SSLMODE=Disable
RIOBRAVO_DB_TIMEOUT=5
